.result-page {
  min-height: 100vh;
  background-color: #FFF8F9;
}

/* loading */
.loading-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #FCE4EC;
  border-top-color: #E91E63;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #E91E63;
}

/* result content */
.result-content {
  min-height: 100vh;
}

.result-scroll {
  height: 100vh;
}

/* personality card */
.personality-card {
  position: relative;
  margin: 24rpx;
  padding: 48rpx 32rpx;
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 50%, #FF80AB 100%);
  border-radius: 32rpx;
  overflow: hidden;
}

.personality-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.1);
}

.circle-1 {
  width: 200rpx;
  height: 200rpx;
  top: -40rpx;
  right: -20rpx;
}

.circle-2 {
  width: 120rpx;
  height: 120rpx;
  bottom: 20rpx;
  left: -30rpx;
}

.circle-3 {
  width: 80rpx;
  height: 80rpx;
  top: 50%;
  right: 30%;
}

.personality-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.personality-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 16rpx;
}

.personality-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 16rpx;
  text-align: center;
}

.personality-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  text-align: center;
  line-height: 1.6;
}

/* section */
.section {
  margin: 0 24rpx 24rpx;
  padding: 32rpx 24rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.section-icon {
  font-size: 36rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

/* product list */
.product-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.product-card {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx;
  background: linear-gradient(135deg, #FFFBFC 0%, #FFF0F5 100%);
  border-radius: 20rpx;
  border: 2rpx solid #FCE4EC;
  position: relative;
  transition: transform 0.2s ease;
}

.product-card:active {
  transform: scale(0.98);
}

.product-rank {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  z-index: 2;
}

.product-image-wrapper {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  position: relative;
}

.product-image {
  width: 100%;
  height: 100%;
}

.sold-out-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sold-out-text {
  padding: 4rpx 20rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  font-size: 24rpx;
  border-radius: 4rpx;
}

.product-info {
  flex: 1;
  padding-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 180rpx;
}

.product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-top: 8rpx;
}

.product-subtitle {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.product-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 24rpx;
  color: #E91E63;
  font-weight: 600;
}

.price-value {
  font-size: 36rpx;
  color: #E91E63;
  font-weight: 600;
}

.price-original {
  font-size: 22rpx;
  color: #CCCCCC;
  text-decoration: line-through;
  margin-left: 8rpx;
}

.add-cart-btn {
  width: 52rpx;
  height: 52rpx;
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.add-cart-btn:active {
  transform: scale(0.9);
}

.add-cart-icon {
  color: #FFFFFF;
  font-weight: 600;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.restock-hint {
  width: 52rpx;
  height: 52rpx;
  background-color: #FFF0F5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.restock-icon {
  font-size: 28rpx;
  line-height: 1;
}

/* reason */
.product-reason {
  width: 100%;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #FCE4EC;
}

.reason-icon {
  font-size: 28rpx;
  flex-shrink: 0;
  line-height: 1.5;
}

.reason-text {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
}

/* share section */
.share-section {
  margin: 0 24rpx 24rpx;
}

.share-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.share-emoji {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.share-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.share-desc {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 32rpx;
}

.share-btn {
  width: 320rpx;
  height: 76rpx;
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 100%) !important;
  border-radius: 38rpx !important;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(233, 30, 99, 0.25);
  padding: 0;
  margin: 0;
  border: none;
  line-height: 76rpx;
}

.share-btn::after {
  border: none;
}

.share-btn-text {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}

/* action bar */
.action-bar {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  padding-bottom: 0;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease;
}

.action-btn:active {
  transform: scale(0.96);
}

.action-btn-secondary {
  background-color: #FFFFFF;
  border: 2rpx solid #E91E63;
}

.action-btn-text-secondary {
  font-size: 28rpx;
  color: #E91E63;
  font-weight: 500;
}

.action-btn-primary {
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 100%);
}

.action-btn-text-primary {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.bottom-safe-area {
  height: 32rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
