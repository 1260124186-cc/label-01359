.page-container {
  min-height: 100vh;
  background-color: #FFF8F9;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.header-section {
  position: relative;
  padding: 40rpx 32rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 50%, #FF80AB 100%);
}

.header-content {
  position: relative;
  z-index: 1;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.header-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.festival-section {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.section-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.section-label-icon {
  font-size: 32rpx;
}

.section-label-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.festival-scroll {
  white-space: nowrap;
}

.festival-scroll-inner {
  display: inline-flex;
  gap: 16rpx;
}

.festival-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #FFF0F5 0%, #FCE4EC 100%);
  border-radius: 32rpx;
  border: 2rpx solid #FCE4EC;
}

.festival-emoji {
  font-size: 28rpx;
}

.festival-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #E91E63;
}

.festival-days {
  font-size: 22rpx;
  color: #FF4081;
  padding: 2rpx 12rpx;
  background-color: rgba(233, 30, 99, 0.1);
  border-radius: 16rpx;
}

.recommend-section {
  margin: 0 24rpx 24rpx;
}

.recommend-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.recommend-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.recommend-occasion {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.occasion-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.occasion-emoji {
  font-size: 36rpx;
}

.occasion-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.occasion-date-badge {
  padding: 6rpx 16rpx;
  background-color: #F0F0F0;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #666666;
}

.occasion-date-badge.urgent {
  background-color: #FFF0F5;
  color: #E91E63;
}

.recommend-recipient {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  background-color: #FAFAFA;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.recipient-icon {
  font-size: 28rpx;
}

.recipient-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333333;
}

.recipient-phone {
  font-size: 24rpx;
  color: #999999;
  margin-left: 8rpx;
}

.recommend-products {
  margin-bottom: 20rpx;
}

.product-compare {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.compare-item {
  flex: 1;
  background-color: #FAFAFA;
  border-radius: 16rpx;
  overflow: hidden;
  transition: transform 0.2s ease;
}

.compare-item:active {
  transform: scale(0.98);
}

.compare-item.upgraded {
  border: 2rpx solid #FFD700;
  background: linear-gradient(135deg, #FFFBF0 0%, #FFF8E1 100%);
}

.compare-image {
  width: 100%;
  height: 180rpx;
}

.compare-info {
  padding: 16rpx;
}

.compare-label {
  display: block;
  font-size: 20rpx;
  color: #999999;
  margin-bottom: 6rpx;
}

.upgrade-label {
  color: #FF9800;
  font-weight: 600;
}

.compare-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.compare-subtitle {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 10rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.compare-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 22rpx;
  color: #E91E63;
  font-weight: 600;
}

.price-value {
  font-size: 32rpx;
  color: #E91E63;
  font-weight: 600;
}

.compare-arrow {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.arrow-icon {
  font-size: 32rpx;
  color: #FF9800;
  font-weight: 700;
}

.arrow-text {
  font-size: 20rpx;
  color: #FF9800;
  font-weight: 600;
}

.recommend-card-preview {
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.card-preview-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.card-edit-hint {
  font-size: 22rpx;
  color: #E91E63;
  font-weight: 400;
}

.card-preview-content {
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
}

.card-preview-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.card-preview-text {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
}

.recommend-address {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 20rpx;
  background-color: #F0FFF0;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.address-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.address-text {
  flex: 1;
  font-size: 22rpx;
  color: #666666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.address-auto {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #4CAF50;
  padding: 4rpx 12rpx;
  background-color: rgba(76, 175, 80, 0.1);
  border-radius: 8rpx;
}

.recommend-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: transform 0.2s ease;
}

.action-btn:active {
  transform: scale(0.98);
}

.repurchase-btn {
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 100%);
  color: #FFFFFF;
}

.upgrade-btn {
  background: linear-gradient(135deg, #FF9800 0%, #FFB74D 100%);
  color: #FFFFFF;
}

.action-btn-icon {
  font-size: 28rpx;
}

.history-section {
  margin: 0 24rpx 24rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.2s ease;
}

.history-item:active {
  transform: scale(0.99);
}

.history-item.near {
  border-left: 6rpx solid #E91E63;
}

.history-left {
  flex-shrink: 0;
}

.history-emoji {
  font-size: 40rpx;
}

.history-center {
  flex: 1;
  min-width: 0;
}

.history-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.history-occasion {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.history-date {
  font-size: 22rpx;
  color: #999999;
}

.history-product {
  display: block;
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.history-recipient {
  display: block;
  font-size: 22rpx;
  color: #999999;
}

.history-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.history-status {
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
}

.status-near {
  background-color: #FFF0F5;
  color: #E91E63;
}

.status-far {
  background-color: #F5F5F5;
  color: #999999;
}

.history-repurchase-btn {
  padding: 10rpx 24rpx;
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 100%);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.bottom-safe-area {
  height: 32rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-content {
  width: 100%;
  max-height: 80vh;
  background-color: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #999999;
}

.card-list {
  max-height: 300rpx;
  padding: 24rpx 32rpx;
}

.card-option {
  position: relative;
  margin-bottom: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  border: 2rpx solid #EEEEEE;
  transition: border-color 0.2s ease;
}

.card-option.selected {
  border-color: #E91E63;
}

.card-option-preview {
  padding: 24rpx 20rpx;
  border-radius: 12rpx;
}

.card-option-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.card-option-text {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.5;
}

.card-option-check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
}

.card-edit-section {
  padding: 0 32rpx 24rpx;
  position: relative;
}

.card-edit-label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 12rpx;
}

.card-edit-input {
  width: 100%;
  height: 160rpx;
  padding: 20rpx;
  background-color: #FAFAFA;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #333333;
  line-height: 1.5;
  box-sizing: border-box;
}

.card-edit-count {
  position: absolute;
  right: 44rpx;
  bottom: 36rpx;
  font-size: 22rpx;
  color: #CCCCCC;
}

.modal-footer {
  padding: 24rpx 32rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #F0F0F0;
}

.confirm-btn {
  padding: 24rpx 0;
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 100%);
  border-radius: 16rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.confirm-btn:active {
  opacity: 0.9;
}
